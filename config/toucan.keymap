#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define SYM  1
#define NAV  2
#define ADJ  3
#define MOU  4
#define COL  5

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <SYM NAV>;
            then-layer = <ADJ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
&kp TAB        &kp Q  &kp W  &kp E     &kp R      &kp T    &kp Y    &kp U      &kp I      &kp O    &kp P     &kp BSPC
&mt LCTRL ESC  &kp A  &kp S  &kp D     &kp F      &kp G    &kp H    &kp J      &kp K      &kp L    &kp SEMI  &kp RET
&kp LSHFT      &kp Z  &kp X  &kp C     &kp V      &kp B    &kp N    &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp SINGLE_QUOTE
                             &kp LGUI  &kp SPACE  &mo SYM  &mo NAV  &kp SPACE  &kp RALT
            >;
        };

        symbol {
            display-name = "SYM";
            bindings = <
&kp F1     &kp F2  &kp F3      &kp F4        &kp F5        &kp F6        &kp F7  &kp F8     &kp F9     &kp F10           &kp F11            &kp F12
&kp GRAVE  &kp N1  &kp N2      &kp N3        &kp N4        &kp N5        &kp N6  &kp N7     &kp N8     &kp N9            &kp N0             &kp DEL
&trans     &trans  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp LEFT_ALT  &trans  &kp MINUS  &kp EQUAL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH
                               &trans        &trans        &trans        &trans  &trans     &trans
            >;
        };

        navigation {
            display-name = "NAV";
            bindings = <
&trans  &trans  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT    &trans        &trans    &kp PAGE_UP    &kp UP            &kp PAGE_DOWN  &trans  &trans
&trans  &trans  &kp C_MUTE  &kp C_VOL_DN      &kp C_VOL_UP  &trans        &kp HOME  &kp LEFT       &kp DOWN          &kp RIGHT      &trans  &trans
&trans  &trans  &trans      &trans            &trans        &kp LEFT_ALT  &kp END   &kp C_AC_BACK  &kp C_AC_FORWARD  &trans         &trans  &trans
                            &trans            &trans        &trans        &trans    &trans         &trans
            >;
        };

        adjust {
            display-name = "ADJ";
            bindings = <
&tog COL    &trans          &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &studio_unlock  &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans
                                          &trans        &trans        &trans        &trans  &trans  &trans
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
&trans  &trans    &trans  &trans     &trans     &trans     &trans     &trans     &trans     &trans  &trans  &trans
&trans  &trans    &trans  &trans     &trans     &trans     &trans     &trans     &trans     &trans  &trans  &trans
&trans  &kp LGUI  &trans  &trans     &trans     &trans     &trans     &trans     &trans     &trans  &trans  &trans
                          &mkp MCLK  &mkp LCLK  &mkp RCLK  &mkp LCLK  &mkp RCLK  &mkp MCLK
            >;
        };

        colemak {
            display-name = "COL";
            // Tab is &trans here so it falls through to BASE's TAB normally, but reaches
            // ADJ's &tog COL (layer 5 > layer 3) while ADJ is active - otherwise COL's
            // TAB would shadow the toggle and the layer could never be toggled off.
            bindings = <
&trans       &kp Q  &kp W  &kp F     &kp P      &kp G    &kp J    &kp L      &kp U      &kp Y    &kp SEMI  &kp BSPC
&mt LCTRL ESC  &kp A  &kp R  &kp S     &kp T      &kp D    &kp H    &kp N      &kp E      &kp I    &kp O     &kp RET
&kp LSHFT      &kp Z  &kp X  &kp C     &kp V      &kp B    &kp K    &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp SINGLE_QUOTE
                             &kp LGUI  &kp SPACE  &mo SYM  &mo NAV  &kp SPACE  &kp RALT
            >;
        };

        extra_3 { status = "reserved"; };
    };
};
